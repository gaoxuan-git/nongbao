@startuml
skinparam defaultFontSize 14
skinparam defaultFontName Microsoft YaHei

start
:开始构建;

partition "后端构建" {
  :清理旧文件;
  :编译源代码;
  :运行单元测试;
  :打包依赖;
  :生成JAR包;
}

partition "前端构建" {
  :清理旧文件;
  :编译源代码;
  :压缩资源;
  :生成静态文件;
}

:验证构建产物;
if (构建成功?) then (是)
  :构建完成;
  stop
else (否)
  :检查构建日志;
  :修复问题;
  backward
endif

@enduml

